<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title>ប្រព័ន្ធតេស្តគណិតវិទ្យាថ្នាក់ទី៨ - វិទ្យាល័យ ជា ស៊ីម ឈូកវ៉ា</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Kantumruy Pro, Moul, & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Moul&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- html2canvas for Certificate Download -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <!-- Firebase SDKs for Auto Sync to Central Collector App -->
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Kantumruy Pro"', '"Plus Jakarta Sans"', 'sans-serif'],
                        moul: ['"Moul"', 'serif'],
                    },
                    colors: {
                        gold: {
                            50: '#fffbeb',
                            100: '#fef3c7',
                            200: '#fde68a',
                            300: '#fcd34d',
                            400: '#fbbf24',
                            500: '#f59e0b',
                            600: '#d97706',
                            700: '#b45309',
                            800: '#92400e',
                            900: '#78350f',
                            950: '#451a03',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Anti-Cheat & Security Locks: No Copy, No Select, No Callout */
        * {
            -webkit-user-select: none !important;
            -moz-user-select: none !important;
            -ms-user-select: none !important;
            user-select: none !important;
            -webkit-touch-callout: none !important;
        }
        input, select {
            -webkit-user-select: auto !important;
            user-select: auto !important;
        }

        /* Pure HTML Mathematical Fraction Styling */
        .fraction {
            display: inline-flex;
            flex-direction: column;
            vertical-align: middle;
            text-align: center;
            padding: 0 4px;
            font-weight: 700;
            line-height: 1.1;
        }
        .fraction .num {
            border-bottom: 2px solid currentColor;
            padding-bottom: 1px;
            display: block;
        }
        .fraction .den {
            padding-top: 1px;
            display: block;
        }

        /* Luxury Gold Theme */
        .bg-luxury-dark {
            background: radial-gradient(circle at 50% 20%, #1c1408 0%, #0c0a06 60%, #050402 100%);
        }
        .gold-gradient-text {
            background: linear-gradient(135deg, #fef08a 0%, #facc15 30%, #eab308 50%, #ca8a04 80%, #a16207 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .gold-border-glow {
            border: 2px solid rgba(234, 179, 8, 0.6);
            box-shadow: 0 0 35px rgba(234, 179, 8, 0.25), inset 0 0 20px rgba(234, 179, 8, 0.1);
        }
        .gold-card {
            background: linear-gradient(145deg, rgba(30, 24, 15, 0.95) 0%, rgba(18, 14, 8, 0.95) 100%);
            border: 1px solid rgba(234, 179, 8, 0.4);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(254, 240, 138, 0.2);
        }
        .gold-button {
            background: linear-gradient(135deg, #fef08a 0%, #eab308 50%, #b45309 100%);
            color: #1c1408;
            box-shadow: 0 6px 20px rgba(202, 138, 4, 0.4);
            transition: all 0.3s ease;
        }
        .gold-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(202, 138, 4, 0.6);
            filter: brightness(1.08);
        }
        .cert-bg {
            background: #ffffff;
            background-image: 
                radial-gradient(circle at 50% 50%, rgba(254, 243, 199, 0.4) 0%, rgba(255, 255, 255, 1) 85%),
                linear-gradient(45deg, rgba(217, 119, 6, 0.03) 25%, transparent 25%), 
                linear-gradient(-45deg, rgba(217, 119, 6, 0.03) 25%, transparent 25%);
        }
    </style>
</head>
<body class="bg-luxury-dark text-slate-100 min-h-screen font-sans flex flex-col justify-between selection:bg-transparent selection:text-transparent">

    <!-- Anti-Cheat Security Violation Overlay -->
    <div id="securityViolationModal" class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-2xl hidden items-center justify-center p-4">
        <div class="bg-slate-900 border-2 border-rose-500 p-8 rounded-3xl max-w-md w-full text-center space-y-5 shadow-2xl">
            <div class="w-16 h-16 rounded-full bg-rose-500/20 text-rose-500 border border-rose-500/40 flex items-center justify-center mx-auto text-3xl animate-bounce">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div class="space-y-1">
                <h3 class="text-lg font-bold text-rose-400">ការព្រមានសុវត្ថិភាពប្រឡង!</h3>
                <p id="securityViolationReason" class="text-xs text-slate-300 leading-relaxed">
                    ប្រព័ន្ធបានចាប់សញ្ញាថាអ្នកបានចាកចេញពីផ្ទាំងតេស្ត ឬព្យាយាមបំបែកអេក្រង់!
                </p>
            </div>
            <div class="p-3 rounded-2xl bg-rose-950/40 border border-rose-900/60 text-[11px] text-rose-300">
                ចំនួនដងល្មើសបម្រាម៖ <strong id="violationCountBadge" class="text-rose-400 text-sm font-mono">1 / 3</strong> (បើសិនលើស ៣ ដង លទ្ធផលតេស្តនឹងត្រូវចាត់ទុកជាមោឃៈ!)
            </div>
            <button onclick="resumeQuizAfterViolation()" class="w-full py-3 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-lg shadow-rose-600/30 transition">
                ខ្ញុំយល់ព្រម និងបន្តការធ្វើតេស្តវិញ
            </button>
        </div>
    </div>

    <!-- Hint Modal Box -->
    <div id="hintModal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-md hidden items-center justify-center p-4">
        <div class="gold-card border border-amber-400/50 p-6 rounded-3xl max-w-sm w-full space-y-4 shadow-2xl text-center">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/20 text-amber-400 border border-amber-400/30 flex items-center justify-center mx-auto text-xl">
                <i class="fa-solid fa-lightbulb"></i>
            </div>
            <div class="space-y-1">
                <h3 class="text-base font-bold text-amber-300">ជំនួយគន្លឹះដោះស្រាយ (Hint)</h3>
                <p id="hintText" class="text-xs text-amber-100/90 leading-relaxed p-3 bg-amber-950/40 rounded-xl border border-amber-500/30 text-left">
                    -
                </p>
            </div>
            <div class="flex justify-between items-center text-[11px] text-slate-400 border-t border-amber-500/20 pt-3">
                <span>ជំនួយនៅសល់៖ <strong id="hintRemainingBadge" class="text-amber-400 font-bold">2/3</strong></span>
                <button onclick="closeHintModal()" class="px-4 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-400/40 font-semibold transition">
                    បិទ
                </button>
            </div>
        </div>
    </div>

    <!-- Top Brand Header -->
    <header class="w-full border-b border-amber-500/20 bg-black/40 backdrop-blur-md sticky top-0 z-40">
        <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-amber-500 via-yellow-400 to-amber-700 p-0.5 shadow-lg shadow-amber-500/20 shrink-0">
                    <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center text-amber-400 text-lg font-bold">
                        <i class="fa-solid fa-crown"></i>
                    </div>
                </div>
                <div>
                    <h1 class="font-bold text-sm sm:text-base leading-tight text-white flex items-center gap-2">
                        <span>វិទ្យាល័យ ជា ស៊ីម ឈូកវ៉ា</span>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-semibold">ថ្នាក់ទី ៨</span>
                    </h1>
                    <p class="text-[11px] text-amber-200/70 font-medium">
                        មេរៀនទី១៖ ការប្រៀបធៀបចំនួនសនិទាន • គ្រូបង្រៀន៖ <strong class="text-amber-400 font-bold">លោកគ្រូ ចាន់ សុខហេង</strong>
                    </p>
                </div>
            </div>

            <!-- Security Shield Icon -->
            <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-950/60 border border-amber-500/30 text-[11px] text-amber-300">
                    <i class="fa-solid fa-shield-halved text-emerald-400"></i>
                    <span>Secure Exam Lock</span>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-3xl w-full mx-auto p-4 sm:p-6 flex items-center justify-center">

        <!-- ================= ផ្ទាំងទី ១: ផ្ទាំងស្វាគមន៍មាសប្រណិត ================= -->
        <div id="screen1_welcome" class="w-full gold-card gold-border-glow rounded-[2.5rem] p-6 sm:p-12 text-center space-y-8 relative overflow-hidden">
            <div class="space-y-4 relative z-10">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-400/30 text-amber-300 text-xs font-bold tracking-wider uppercase">
                    <i class="fa-solid fa-sparkles text-amber-300"></i>
                    <span>Math Assessment Challenge • ២០២៦-២០២៧</span>
                </div>

                <h1 class="font-moul text-xl sm:text-3xl leading-relaxed sm:leading-loose gold-gradient-text tracking-wide pt-2">
                    តេស្តសមត្ថភាពគណិតវិទ្យា
                </h1>
                <p class="text-base sm:text-lg font-bold text-amber-100/90 tracking-wide">
                    មេរៀនទី១៖ ការប្រៀបធៀប និងរៀបលំដាប់ចំនួនសនិទាន
                </p>
                <div class="w-28 h-0.5 mx-auto bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-left relative z-10 text-xs">
                <div class="p-4 rounded-2xl bg-amber-950/40 border border-amber-500/30 space-y-1">
                    <div class="text-amber-400 font-extrabold text-sm flex items-center gap-1.5">
                        <i class="fa-solid fa-forward-step"></i> លំហាត់លោតបន្តបន្ទាប់
                    </div>
                    <p class="text-slate-300 text-[11px] leading-relaxed">
                        ធ្វើលំហាត់មួយចប់ នឹងលោតទៅលំហាត់បន្ទាប់ភ្លាមៗរហូតដល់ចប់ទាំង ១៥ លំហាត់។
                    </p>
                </div>
                <div class="p-4 rounded-2xl bg-amber-950/40 border border-amber-500/30 space-y-1">
                    <div class="text-amber-400 font-extrabold text-sm flex items-center gap-1.5">
                        <i class="fa-solid fa-lightbulb text-yellow-300"></i> មាន Hint ៣ ដង
                    </div>
                    <p class="text-slate-300 text-[11px] leading-relaxed">
                        មានជំនួយគន្លឹះដោះស្រាយ ៣ ដងគត់សម្រាប់ប្រើប្រាស់ពេលជួបលំហាត់ពិបាក។
                    </p>
                </div>
                <div class="p-4 rounded-2xl bg-amber-950/40 border border-amber-500/30 space-y-1">
                    <div class="text-amber-400 font-extrabold text-sm flex items-center gap-1.5">
                        <i class="fa-solid fa-lock text-rose-400"></i> ប្រព័ន្ធសុវត្ថិភាពខ្ពស់
                    </div>
                    <p class="text-slate-300 text-[11px] leading-relaxed">
                        ហាម Screenshot, ហាមបំបែកអេក្រង់, ហាមឆ្លាស់កម្មវិធី និងហាម Copy លំហាត់។
                    </p>
                </div>
            </div>

            <div class="pt-4 relative z-10">
                <button onclick="goToScreen(2)" class="gold-button px-10 py-4 rounded-2xl font-bold text-base uppercase tracking-wider inline-flex items-center gap-3">
                    <span>ចូលរួមធ្វើតេស្តឥឡូវនេះ</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </div>

        <!-- ================= ផ្ទាំងទី ២: ផ្ទាំងសិស្សបំពេញព័ត៌មាន (ថ្នាក់ទី A1 ដល់ F2) ================= -->
        <div id="screen2_registration" class="w-full gold-card gold-border-glow rounded-[2.5rem] p-6 sm:p-10 space-y-6 hidden relative overflow-hidden">
            <div class="text-center space-y-2 border-b border-amber-500/20 pb-4">
                <span class="px-3.5 py-1 rounded-full bg-amber-500/10 border border-amber-400/30 text-amber-300 text-xs font-bold uppercase tracking-wider">
                    ជំហានទី ១ • បញ្ចូលព័ត៌មានបេក្ខជន
                </span>
                <h2 class="font-moul text-lg sm:text-2xl text-amber-300 pt-1">
                    ព័ត៌មានសិស្សានុសិស្ស
                </h2>
                <p class="text-xs text-slate-400">
                    សូមបំពេញព័ត៌មានឱ្យបានត្រឹមត្រូវ ដើម្បីបង្ហាញលើបណ្ណសរសើរផ្លូវការ
                </p>
            </div>

            <form id="studentRegistrationForm" onsubmit="handleRegistrationSubmit(event)" class="space-y-4 max-w-lg mx-auto text-xs">
                <div>
                    <label class="block font-semibold text-amber-200 mb-1.5">គោត្តនាម និងនាមសិស្ស (ឈ្មោះពេញ) <span class="text-rose-400">*</span></label>
                    <div class="relative">
                        <i class="fa-solid fa-user absolute left-3.5 top-3.5 text-amber-400 text-sm"></i>
                        <input type="text" id="stuName" required placeholder="ឧ. ការែន សុផាន់ណា" class="w-full pl-10 pr-4 py-3 rounded-xl border border-amber-500/40 bg-black/50 text-white font-medium text-sm focus:outline-none focus:ring-2 focus:ring-amber-400">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label class="block font-semibold text-amber-200 mb-1.5">ភេទ <span class="text-rose-400">*</span></label>
                        <select id="stuGender" required class="w-full px-3.5 py-3 rounded-xl border border-amber-500/40 bg-black/50 text-white font-semibold text-sm focus:outline-none focus:ring-2 focus:ring-amber-400">
                            <option value="ប្រុស">ប្រុស (Male)</option>
                            <option value="ស្រី">ស្រី (Female)</option>
                        </select>
                    </div>

                    <!-- ថ្នាក់ទី A1, A2, B1, B2, C1, C2, D1, D2, E1, E2, F1, F2 -->
                    <div>
                        <label class="block font-semibold text-amber-200 mb-1.5">ថ្នាក់ទី (Grade Room) <span class="text-rose-400">*</span></label>
                        <select id="stuGrade" required class="w-full px-3.5 py-3 rounded-xl border border-amber-500/40 bg-black/50 text-amber-300 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-amber-400">
                            <option value="A1">ថ្នាក់ទី 8A1</option>
                            <option value="A2">ថ្នាក់ទី 8A2</option>
                            <option value="B1">ថ្នាក់ទី 8B1</option>
                            <option value="B2">ថ្នាក់ទី 8B2</option>
                            <option value="C1">ថ្នាក់ទី 8C1</option>
                            <option value="C2" selected>ថ្នាក់ទី 8C2</option>
                            <option value="D1">ថ្នាក់ទី 8D1</option>
                            <option value="D2">ថ្នាក់ទី 8D2</option>
                            <option value="E1">ថ្នាក់ទី 8E1</option>
                            <option value="E2">ថ្នាក់ទី 8E2</option>
                            <option value="F1">ថ្នាក់ទី 8F1</option>
                            <option value="F2">ថ្នាក់ទី 8F2</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-amber-200 mb-1.5">គ្រឹះស្ថានសិក្សា</label>
                    <input type="text" id="stuSchool" readonly value="វិទ្យាល័យ ជា ស៊ីម ឈូកវ៉ា" class="w-full px-3.5 py-3 rounded-xl border border-amber-500/30 bg-black/30 text-amber-100 font-medium text-sm focus:outline-none cursor-not-allowed">
                </div>

                <div class="pt-4 flex gap-3">
                    <button type="button" onclick="goToScreen(1)" class="px-5 py-3 rounded-xl border border-slate-700 bg-slate-900/60 hover:bg-slate-800 text-slate-300 font-bold transition">
                        ត្រឡប់ក្រោយ
                    </button>
                    <button type="submit" class="flex-1 gold-button py-3 rounded-xl font-bold text-sm shadow-md flex items-center justify-center gap-2">
                        <span>ចូលធ្វើតេស្ត & ចាក់សោសុវត្ថិភាព</span>
                        <i class="fa-solid fa-lock"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- ================= ផ្ទាំងធ្វើតេស្ត៖ ធ្វើលំហាត់មួយចប់ លោតមួយទៀតបន្តបន្ទាប់ + HINT ៣ ដង ================= -->
        <div id="screen_quiz_workspace" class="w-full gold-card gold-border-glow rounded-[2.5rem] p-5 sm:p-8 space-y-6 hidden">
            
            <!-- Top Status & Hint Controller Bar -->
            <div class="flex items-center justify-between gap-3 border-b border-amber-500/20 pb-4">
                <div class="space-y-1">
                    <span id="quizBadgeLevel" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                        កម្រិតទី ១ (ស្រាល)
                    </span>
                    <h3 id="quizProgressText" class="text-sm font-bold text-white">
                        សំណួរទី ១ នៃ ១៥
                    </h3>
                </div>

                <div class="flex items-center gap-3">
                    <!-- Hint Button (Max 3 uses) -->
